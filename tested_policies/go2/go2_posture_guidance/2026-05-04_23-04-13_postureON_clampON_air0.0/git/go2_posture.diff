+    """Compute guide roll, pitch, and height from velocity commands and longitudinal acceleration.
+
+    Args:
+        commands: [N, 3] velocity commands (vx, vy, wz)
+        a_long: [N] filtered longitudinal acceleration (v_x_dot)
+        cfg: environment config with guide_* parameters
+
+    Returns:
+        roll_guide:  [N] φ^guide = sat(k_φ · arctan(a_lat / g), φ_max)
+        pitch_guide: [N] θ^guide = sat(k_θ · arctan(a_long / g), θ_max)
+        height_guide: [N] h^guide = clip(h_nom - k_h^lat·|a_lat| - k_h^long·|a_long| - k_h^speed·|v|², h_min, h_nom)
+    """
+    g = cfg.guide_gravity
+
+    # --- a_lat: centripetal acceleration = |v| * |wz| ---
+    vel_magnitude = torch.linalg.norm(commands[:, :2], dim=1)
+    abs_wz = torch.abs(commands[:, 2])
+    a_lat = vel_magnitude * abs_wz
+
+    # --- Roll guide: φ = sat(k_φ · arctan(a_lat / g), φ_max) ---
+    roll_raw = cfg.guide_k_roll * torch.atan(a_lat / g)
+    # Sign: lean inward (opposite to turning direction)
+    roll_signed = torch.where(commands[:, 2] > 0.0, -roll_raw, roll_raw)
+    no_turn = (abs_wz < 1e-6) | (vel_magnitude < 1e-6)
+    roll_signed = torch.where(no_turn, torch.zeros_like(roll_signed), roll_signed)
+    if cfg.guide_clamp_enabled:
+        roll_guide = torch.clamp(roll_signed, -cfg.guide_roll_max, cfg.guide_roll_max)
+    else:
+        roll_guide = roll_signed
+
+    # --- Pitch guide: θ = sat(k_θ · arctan(a_long / g), θ_max) ---
+    # Positive a_long (accelerating forward) → lean forward (negative pitch in Isaac convention)
+    pitch_raw = cfg.guide_k_pitch * torch.atan(a_long / g)
+    # Negate: forward accel → nose down (negative pitch)
+    if cfg.guide_clamp_enabled:
+        pitch_guide = torch.clamp(-pitch_raw, -cfg.guide_pitch_max, cfg.guide_pitch_max)
+    else:
+        pitch_guide = -pitch_raw
+
+    # --- Height guide: h = clip(h_nom - k_h_lat*|a_lat| - k_h_long*|a_long| - k_h_speed*|v|², h_min, h_nom) ---
+    a_long_abs = torch.abs(a_long)
+    vel_sq = vel_magnitude ** 2  # v² 항: 고속 직진 시에도 높이 하강
+    height_guide = (
+        cfg.guide_h_nom
+        - cfg.guide_kh_lat * a_lat
+        - cfg.guide_kh_long * a_long_abs
+        - cfg.guide_kh_speed * vel_sq
+    )
+    if cfg.guide_clamp_enabled:
+        height_guide = torch.clamp(height_guide, min=cfg.guide_h_min, max=cfg.guide_h_nom)
+
+    return roll_guide, pitch_guide, height_guide
+

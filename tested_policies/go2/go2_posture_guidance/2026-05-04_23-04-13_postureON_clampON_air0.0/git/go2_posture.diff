+def posture_to_joint_targets(
+    roll: torch.Tensor,
+    pitch: torch.Tensor,
+    height: torch.Tensor,
+    default_joint_pos: torch.Tensor,
+    h_nom: float,
+    k_roll_hip: float = 0.3,
+    k_pitch_thigh: float = 0.5,
+    k_h_thigh: float = 3.0,
+    k_h_calf: float = 4.0,
+) -> torch.Tensor:
+    """Convert guide posture targets (roll, pitch, height) into 12d joint position targets.
+
+    Joint order: FL_hip(0), FL_thigh(1), FL_calf(2), FR_hip(3), FR_thigh(4), FR_calf(5),
+                 RL_hip(6), RL_thigh(7), RL_calf(8), RR_hip(9), RR_thigh(10), RR_calf(11)
+    """
+    N = roll.shape[0]
+    delta = torch.zeros(N, 12, device=roll.device)
+
+    # Roll → hip abduction (lean left/right)
+    # L_hip default=+0.1, R_hip default=-0.1; same sign delta shifts CoM in roll direction
+    delta[:, 0] = k_roll_hip * roll   # FL_hip
+    delta[:, 3] = k_roll_hip * roll   # FR_hip
+    delta[:, 6] = k_roll_hip * roll   # RL_hip
+    delta[:, 9] = k_roll_hip * roll   # RR_hip
+
+    # Pitch → front/rear thigh difference (lean forward/backward)
+    # Negative pitch (forward lean): front thighs extend (decrease), rear thighs flex (increase)
+    delta[:, 1] = k_pitch_thigh * pitch    # FL_thigh
+    delta[:, 4] = k_pitch_thigh * pitch    # FR_thigh
+    delta[:, 7] = -k_pitch_thigh * pitch   # RL_thigh
+    delta[:, 10] = -k_pitch_thigh * pitch  # RR_thigh
+
+    # Height → thigh/calf symmetric bend (lower/raise stance)
+    delta_h = height - h_nom  # negative = lower stance
+    delta[:, 1] += -k_h_thigh * delta_h   # FL_thigh
+    delta[:, 4] += -k_h_thigh * delta_h   # FR_thigh
+    delta[:, 7] += -k_h_thigh * delta_h   # RL_thigh
+    delta[:, 10] += -k_h_thigh * delta_h  # RR_thigh
+    delta[:, 2] = k_h_calf * delta_h      # FL_calf
+    delta[:, 5] = k_h_calf * delta_h      # FR_calf
+    delta[:, 8] = k_h_calf * delta_h      # RL_calf
+    delta[:, 11] = k_h_calf * delta_h     # RR_calf
+
+    return default_joint_pos + delta
 
 

+    def __post_init__(self):
+        # Observation space = base_dim × history_length (history concat)
+        history_length = max(1, int(self.obs_history_length))
+        if self.use_concurrent_state_estimator and int(self.concurrent_state_estimator_output_dim) != 3:
+            raise ValueError("concurrent_state_estimator_output_dim must be 3 because it replaces root_lin_vel_b.")
+        if self.use_rma and int(self.rma_output_dim) != 11:
+            raise ValueError("rma_output_dim must be 11 for the current Go2Posture privileged context.")
+        if int(self.critic_privileged_observation_dim) != 11:
+            raise ValueError("critic_privileged_observation_dim must be 11 for the current Go2Posture privileged context.")
+        if self.use_rma and int(self.rma_output_dim) != int(self.critic_privileged_observation_dim):
+            raise ValueError("rma_output_dim must match critic_privileged_observation_dim.")
+
+        self.observation_space = int(self.base_observation_dim * history_length)
+        if self.use_rma:
+            self.observation_space += int(self.rma_output_dim)
+        self.adaptation_observation_space = int(self.adaptation_observation_dim * history_length)
+        if self.use_asymmetric_critic:
+            self.state_space = int(self.observation_space + self.critic_privileged_observation_dim)
+        else:
+            self.state_space = 0
+
+        if self.dr_mode not in ("full", "friction_only"):
+            raise ValueError(f"Unknown dr_mode: {self.dr_mode}. Expected 'full' or 'friction_only'.")
+
+        if self.dr_mode == "friction_only":
+            self.events.foot_contact_material = None
+            self.events.add_base_mass = None
+            self.events.base_com = None
+            self.events.actuator_gains = None
+            self.events.joint_parameters = None
+            self.events.push_robot = None
+
+            surface = str(self.terrain_surface)
+            if surface not in self.terrain_surface_presets:
+                valid = ", ".join(sorted(self.terrain_surface_presets.keys()))
+                raise ValueError(f"Unknown terrain_surface: {surface}. Valid options: {valid}")
+
+            if surface == "manual":
+                static_friction = float(self.friction_only_static_friction)
+                dynamic_friction = float(self.friction_only_dynamic_friction)
+                restitution = float(self.friction_only_restitution)
+            else:
+                static_friction, dynamic_friction, restitution = self.terrain_surface_presets[surface]
+
+            self.terrain.physics_material.static_friction = float(static_friction)
+            self.terrain.physics_material.dynamic_friction = float(dynamic_friction)
+            self.terrain.physics_material.restitution = float(restitution)

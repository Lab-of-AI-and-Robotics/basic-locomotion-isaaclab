+    def _resolve_xy_velocity_to_arrow(self, xy_velocity: torch.Tensor, marker_cfg) -> tuple[torch.Tensor, torch.Tensor]:
+        default_scale = marker_cfg.markers["arrow"].scale
+        # Keep marker scale tensor on the same device as incoming velocity to avoid CPU/GPU mismatch.
+        arrow_scale = torch.tensor(default_scale, device=xy_velocity.device).repeat(xy_velocity.shape[0], 1)
+        arrow_scale[:, 0] *= torch.linalg.norm(xy_velocity, dim=1) * 3.0
+        heading_angle = torch.atan2(xy_velocity[:, 1], xy_velocity[:, 0])
+        zeros = torch.zeros_like(heading_angle)
+        arrow_quat = math_utils.quat_from_euler_xyz(zeros, zeros, heading_angle)
+        arrow_quat = math_utils.quat_mul(self._robot.data.root_quat_w, arrow_quat)
+        return arrow_scale, arrow_quat
